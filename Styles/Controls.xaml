<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SASB_SI_ASSESSMENT.Converters">

    <!-- Converters -->
    <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>

    <!-- Button style for grid buttons -->
    <Style x:Key="GridButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Power button style -->
    <Style x:Key="PowerButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Content" Value="⏻"/>
    </Style>

    <!-- TextBlock in logs -->
    <Style x:Key="LogTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ListView GridViewColumn TextBlock style -->
    <Style x:Key="StatusTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
